# ─── App ────────────────────────────────────────────────
APP_NAME="EventMesh API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ─── Database (Supabase Postgres, asyncpg driver) ───────
# Local dev via docker-compose uses the bundled postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eventmesh
# Production (Supabase): use the "Connection Pooling" (pgBouncer) URL with the
# postgresql+asyncpg:// scheme.

# ─── Supabase Auth ──────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUD=authenticated
# Optional explicit JWKS URL (else derived from SUPABASE_URL):
SUPABASE_JWKS_URL=
# Legacy HS256 shared secret (only if the project still issues symmetric JWTs):
SUPABASE_JWT_SECRET=
# Service role key — SERVER-SIDE ONLY. Never ship to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin / Sync ───────────────────────────────────────
# Long random string; also stored as a GitHub Actions secret.
ADMIN_SYNC_TOKEN=change-me-to-a-long-random-secret

# ─── CORS (comma-separated origins) ─────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Providers ──────────────────────────────────────────
EVENTBRITE_API_KEY=
