# Frontend build-time environment variables (Vite inlines these at build time).
# On Vercel: Project → Settings → Environment Variables, then redeploy.

# REQUIRED — the app shows a configuration screen (not a crash) if these are unset:
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# REQUIRED in production (defaults to http://localhost:8000 for local dev):
VITE_API_BASE_URL=https://eventmesh-api.onrender.com
